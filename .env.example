# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=dev_secret_key_change_me_in_production

# Database Configuration
# Set to 'sqlite' for local SQLite, 'mysql' for production MySQL
DB_TYPE=sqlite

# SQLite Config
SQLITE_DB_PATH=database/sqlite/database.db

# MySQL Config (Only used if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=support_analysis_db
MYSQL_PORT=3306

# SMTP Configuration (Optional - fallback to mock log if not set)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

